# Vercel Blob — server-side upload (used by pipeline scripts only, never bundled to client)
BLOB_READ_WRITE_TOKEN=

# Vercel Blob — public base URL for serving media (client + server)
# Example: <https://abcd1234.public.blob.vercel-storage.com>
NEXT_PUBLIC_BLOB_BASE_URL=

# OpenAI — used by pipeline scripts only (C2 audio gen, C3 image gen)
OPENAI_API_KEY=

# Cross-device sync — generate both with `npx tsx scripts/sync-setup.ts`
# (colon-separated scrypt hash; never put the passphrase itself anywhere)
SYNC_ACCESS_CODE_HASH=
SYNC_SESSION_SECRET=

# Upstash Redis — injected by the Vercel "Upstash for Redis" integration
# (`vercel env pull` to a temp file and copy over; UPSTASH_REDIS_REST_* also accepted).
# Leave empty in local dev to use the file-backed .sync-dev-store.json fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
